From ae7e6d53035be99c24b514cbb26005d37656d632 Mon Sep 17 00:00:00 2001
From: Sourav Nayak <nonameblank007@gmail.com>
Date:   2026-10-10T05:56:38+0200
Subject: [PATCH] slock: update message patch for upcoming 1.8 version and support system fonts

---
 config.def.h |  12 ++++
 config.mk    |   8 ++-
 slock.1      |   7 +++
 slock.c      | 156 +++++++++++++++++++++++++++++++++++++++++++++++++--
 4 files changed, 177 insertions(+), 6 deletions(-)

diff --git a/config.def.h b/config.def.h
index 9855e21..d18e03f 100644
--- a/config.def.h
+++ b/config.def.h
@@ -10,3 +10,15 @@ static const char *colorname[NUMCOLS] = {
 
 /* treat a cleared input like a wrong password (color) */
 static const int failonclear = 1;
+
+/* default message */
+static const char * message = "Suckless: Software that sucks less.";
+
+/* text color */
+static const char * text_color = "#ffffff";
+
+/* font name (slock -f/fc-list) */
+static const char * font_name = "monospace";
+
+/* font size (must be a valid size) */
+static const double font_size = 18.0;
\ No newline at end of file
diff --git a/config.mk b/config.mk
index 9fe5bff..921834e 100644
--- a/config.mk
+++ b/config.mk
@@ -10,9 +10,13 @@ MANPREFIX = ${PREFIX}/share/man
 X11INC = /usr/X11R6/include
 X11LIB = /usr/X11R6/lib
 
+# freetype
+FREETYPELIBS = -lfontconfig -lXft
+FREETYPEINC = /usr/include/freetype2
+
 # includes and libs
-INCS = -I. -I/usr/include -I${X11INC}
-LIBS = -L/usr/lib -lc -lcrypt -L${X11LIB} -lX11 -lXext -lXrandr
+INCS = -I. -I/usr/include -I${X11INC} -I${FREETYPEINC}
+LIBS = -L/usr/lib -lc -lcrypt -L${X11LIB} ${FREETYPELIBS} -lX11 -lXext -lXrandr -lXinerama
 
 # flags
 CPPFLAGS = -DVERSION=\"${VERSION}\" -D_DEFAULT_SOURCE -DHAVE_SHADOW_H
diff --git a/slock.1 b/slock.1
index e485992..66a5f97 100644
--- a/slock.1
+++ b/slock.1
@@ -7,6 +7,8 @@
 .Sh SYNOPSIS
 .Nm
 .Op Fl v
+.Op Fl f
+.Op Fl m Ar message
 .Sh DESCRIPTION
 .Nm
 is a simple X screen locker.
@@ -14,6 +16,11 @@ The options are as follows:
 .Bl -tag -width Ds
 .It Fl v
 Print version information to stdout and exit.
+.It Fl f
+List all valid X fonts and exit.
+.It Fl m
+Overrides default slock lock message.
+.TP
 .El
